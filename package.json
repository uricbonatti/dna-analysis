    "mock-express-response": "^0.3.0",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1",
    "testcontainers": "^11.14.0",
    "ts-jest": "^29.4.14",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1"
